# bash completion for piper-can

_piper_can_completion()
{
    local cur command

    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    command="${COMP_WORDS[1]}"

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "find activate -h --help" -- "${cur}") )
        return 0
    fi

    case "${command}" in
        find)
            COMPREPLY=( $(compgen -W "-h --help" -- "${cur}") )
            ;;
        activate)
            case ${COMP_CWORD} in
                2)
                    COMPREPLY=( $(compgen -W "can0 can1 can_piper -h --help --usb-port" -- "${cur}") )
                    ;;
                3)
                    COMPREPLY=( $(compgen -W "1000000" -- "${cur}") )
                    ;;
                *)
                    COMPREPLY=( $(compgen -W "--usb-port -h --help" -- "${cur}") )
                    ;;
            esac
            ;;
    esac
}

complete -F _piper_can_completion piper-can
